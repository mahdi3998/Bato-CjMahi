# Environment example for Bato

APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.example
APP_NAME=Bato

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bato
DB_USERNAME=bato_user
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

BOT_TOKEN=<BOT_TOKEN_PLACEHOLDER>
ADMIN_IDS=123456789

MWPANEL_ENABLED=true
MWPANEL_BASE_URL=https://panel.example.com
MWPANEL_USERNAME=<MWP_USER>
MWPANEL_PASSWORD=<MWP_PASS>
MWPANEL_TIMEOUT=20
MWPANEL_CONNECT_TIMEOUT=10
MWPANEL_VERIFY_SSL=true

PASARGAD_MODE=sandbox
PASARGAD_MERCHANT_ID=<MERCHANT_ID>
PASARGAD_CALLBACK_URL=https://yourdomain.example/payments/pasargad/callback

INSTALLER_DIR=/home/username/public_html/installers
